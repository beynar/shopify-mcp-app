      "binding": "DB",
      "database_name": "shopify-mcp",
      "database_id": "dc66f670-cfcf-498a-8832-3e6dd501fa56",
      "preview_database_id": "dc66f670-cfcf-498a-8832-3e6dd501fa56",
    },
  ],
  "kv_namespaces": [
