{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shopify-mcp",
  "account_id": "96b47bfc0b6026d08a3b8a514df0be12",
  "main": "./worker.ts",
  "compatibility_date": "2026-03-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
